# Puerto del API
PORT=3001

# Producción: PostgreSQL real. Si no se define, se usa PGlite (Postgres embebido) en ./data/pglite
# DATABASE_URL=postgres://usuario:clave@host:5432/checador

# Carpeta de PGlite (usa "memory" para una base temporal en memoria)
# PGLITE_DIR=./data/pglite

# Secreto para derivar el índice de PINs y los códigos de firma. CAMBIAR en producción.
APP_SECRET=cambia-este-secreto

# Token del panel de RH (MVP; se reemplaza por usuarios con login)
RH_TOKEN=rh-demo

# Carpeta donde se guardan las fotos de evidencia (en producción: S3 o similar)
STORAGE_DIR=./storage

# Demo: calcula con el tope de otro año (p. ej. 2027 = 46 h). Quitar en producción.
SIMULAR_ANIO=2027

# En desarrollo, las respuestas incluyen los códigos de firma (en lugar de mandarlos por WhatsApp)
MODO_DEMO=true
